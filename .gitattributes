# ─────────────────────────────────────────────────────────────────────────────
# Git Line Ending Normalization
# Ensures consistent line endings across Windows/macOS/Linux contributors
# ─────────────────────────────────────────────────────────────────────────────

# Default: normalize all text files to LF in the repo
* text=auto eol=lf

# Explicitly force LF for source files
*.ts         text eol=lf
*.js         text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.md         text eol=lf
*.csv        text eol=lf
*.env        text eol=lf
*.gitignore  text eol=lf
*.txt        text eol=lf
*.sh         text eol=lf

# Windows shell scripts (CRLF preserved)
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# Binary files — no EOL conversion
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.webm       binary
*.mp4        binary
*.zip        binary
*.pdf        binary
